# 2026 HBD 派對遊戲平台 — 環境變數
# 正式場：複製做 .env，設一個自己嘅 6–12 位 PIN（唔准用 000000／123456 等 default）
NODE_ENV=production
PORT=3000
PIN=<PIN>
# 對外 Origin 白名單（Cloudflare 公開 hostname＋屋企 LAN 綵排位址）
PUBLIC_ORIGINS=https://partyhollye.our1tb.com,https://hbd.example.com,http://192.168.99.20:30005,http://127.0.0.1:30005
# 1＝要求 Cloudflare Access header（正式場開；LAN 綵排可 0）
ACCESS_REQUIRED=0
# 1＝join 後自動 approved（只限測試，正式場要主持 approve）
AUTO_APPROVE=0
# 1＝屋企 LAN 綵排跳 Access（production 見到 1 會拒絕啟動）
DEV_LAN_MODE=0
