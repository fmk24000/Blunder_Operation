sion":1,"updatedBy":"seed"},{"id":"rule-quiz","gameId":"quiz","title":"常識問答","subtitle":"每人自己答，答案唔會漏","blocks":[{"id":"rule-quiz-b1","type":"heading","text":"玩法"},{"id":"rule-quiz-b2","type":"steps","items":["大mon 出題，手機揀 A／B／C／D","揀完撳「確認送出」，確認後唔可以改","時間到自動收卷（或主持立即收卷）","大mon 先出分佈，主持再揭曉正解"]},{"id":"rule-quiz-b3","type":"score-table","items":["MC 答對 ＋1（20 秒）","開放題 ＋2（45 秒）","估數字最接近 ＋2"]},{"id":"rule-quiz-b4","type":"callout","text":"唔好睇隔籬；答案一經確認就作實。","emphasis":"hot"}],"order":4,"enabled":true,"autoAdvanceSeconds":0,"updatedAt":1795054668045,"version":1,"updatedBy":"seed"}]}},{"t":"quiz.set","d":{"cards":[{"id":"q1","type":"choice","gameId":"quiz","category":"動物","prompt":"長頸鹿條脷係咩顏色？","seconds":20,"points":1,"version":1,"state":"draft","options":["粉紅色","紫黑色","草綠色","透明"],"correct":1,"explanation":"紫黑色可以防曬，仲可以伸到 50 厘米長，方便捲樹葉。"},{"id":"q2","type":"choice","gameId":"quiz","category":"動物","prompt":"北極熊嘅皮膚其實係咩顏色？","seconds":20,"points":1,"version":1,"state":"draft","options":["白色","黑色","粉紅色","透明"],"correct":1,"explanation":"毛係透明中空，睇落白色；皮膚其實係黑色，方便吸熱。"},{"id":"q3","type":"choice","gameId":"quiz","category":"動物","prompt":"袋鼠可唔可以倒退行？","seconds":20,"points":1,"version":1,"state":"draft","options":["可以，仲好快","可以，但好慢","完全唔可以","只可以倒退跳"],"correct":2,"explanation":"袋鼠腳踝結構唔容許向後行，所以澳洲國徽揀佢代表「永遠向前」。"},{"id":"q4","type":"choice","gameId":"quiz","category":"食物","prompt":"一罈蜂蜜放咗 3000 年，仲食唔食得？","seconds":20,"points":1,"version":1,"state":"draft","options":["一定壞咗","食得，蜂蜜唔會變壞","會變醋","會變石頭"],"correct":1,"explanation":"埃及古墓出土嘅蜂蜜，考古學家話仲食得。含水量低＋酸性強，細菌好難生存。"},{"id":"q5","type":"choice","gameId":"quiz","category":"太空","prompt":"太空人喺太空站去廁所，主要靠咩？","seconds":20,"points":1,"version":1,"state":"draft","options":["用水沖","用吸力（好似吸塵機）","著尿片","去太空船外面"],"correct":1,"explanation":"太空冇重力，要靠氣流將排泄物吸走。"},{"id":"q6","type":"choice","gameId":"quiz","category":"食物","prompt":"世界上最貴嘅香料（按重量計）係？","seconds":20,"points":1,"version":1,"state":"draft","options":["黑胡椒","番紅花","雲呢拿","肉桂"],"correct":1,"explanation":"番紅花要人手逐朵摘花蕊，一公斤要大約 15 萬朵花。"},{"id":"q7","type":"choice","gameId":"quiz","category":"動物","prompt":"蝸牛有幾多隻牙？","seconds":20,"points":1,"version":1,"state":"draft","options":["0 隻","4 隻","大約 1 萬隻","32 隻"],"correct":2,"explanation":"蝸牛嘅牙生喺「齒舌」上面，肉眼睇唔到，但真係過萬隻。"},{"id":"q8","type":"choice","gameId":"quiz","category":"動物","prompt":"樹懶幾耐先去一次大便？","seconds":20,"points":1,"version":1,"state":"draft","options":["一日三次","大約一星期一次","一個月一次","成世都唔去"],"correct":1,"explanation":"樹懶新陳代謝極慢，一星期先落地一次，而且落地面對佢嚟講好危險。"},{"id":"q9","type":"choice","gameId":"quiz","category":"數學","prompt":"一張 A4 紙對摺 42 次，會有幾厚？","seconds":20,"points":1,"version":1,"state":"draft","options":["一本書咁厚","一層樓咁高","超過地球到月球","一座山咁高"],"correct":2,"explanation":"0.1 毫米 × 2⁴² ≈ 44 萬公里；地球到月球約 38 萬公里。"},{"id":"q10","type":"choice","gameId":"quiz","category":"科學","prompt":"你身體入面大部分原子，原本嚟自邊度？","seconds":20,"points":1,"version":1,"state":"draft","options":["地球核心","爆炸咗嘅恆星","太陽","海水"],"correct":1,"explanation":"「我哋都係星塵」——碳、氧、鐵等元素都係喺恆星內部製造出嚟。"},{"id":"q11","type":"open","gameId":"quiz","category":"估數字・即場","prompt":"全場所有人嘅手機加埋，總共裝咗幾多個 App？","seconds":45,"points":2,"version":1,"state":"draft","hint":"iPhone 同 Android 都喺「設定」睇得到。","openKind":"number"},{"id":"q12","type":"open","gameId":"quiz","category":"估數字・即場","prompt":"全場所有人嘅鞋碼加埋，係幾多號？（即刻問隔籬）","seconds":45,"points":2,"version":1,"state":"draft","hint":"用歐碼相加；有人唔知自己碼就當 42。","openKind":"number"},{"id":"q13","type":"open","gameId":"quiz","category":"估數字・即場","prompt":"全場所有人嘅身高加埋，係幾多米？","seconds":45,"points":2,"version":1,"state":"draft","hint":"一齊報數，主持即場加總。","openKind":"number"},{"id":"q14","type":"open","gameId":"quiz","category":"估數字・即場","prompt":"由而家呢一刻到今晚 12 點，仲有幾多分鐘？","seconds":45,"points":2,"version":1,"state":"draft","hint":"答案隨時間變，以收卷嗰刻 server 時間為準（大mon 顯示嘅時間）。","openKind":"number","autoAnswer":"minutes-to-midnight"},{"id":"q15","type":"open","gameId":"quiz","category":"估數字・常識","prompt":"香港人平均每日用手機幾多個鐘？","seconds":45,"points":2,"version":1,"state":"draft","referenceAnswer":"約 4 小時","hint":"講「多過你以